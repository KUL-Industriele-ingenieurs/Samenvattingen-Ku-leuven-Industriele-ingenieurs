[
    {
        "key": "ctrl+alt+v",
        "command": "latex-utilities.formattedPaste",
        "when": "editorTextFocus && (editorLangId == 'latex' || editorLangId == 'tex')"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-latex-workshop.view"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-latex-workshop.view-pdf"
    },
    {
        "key": "ctrl+alt+shift+p",
        "command": "latex-workshop.view",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+shift+p",
        "command": "latex-workshop.view-pdf",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+i",
        "command": "extension.pasteImage",
        "when": "editorTextFocus && editorLangId == 'typst'"
    },
    {
        "key": "tab",
        "command": "editor.action.inlineSuggest.commit",
        "when": "inlineSuggestionHasIndentationLessThanTabSize || inlineSuggestionVisible"
    },
    {
        "key": "alt+\\",
        "command": "editor.action.inlineSuggest.trigger",
        "when": "editorTextFocus && !inlineSuggestionVisible"
    }
]
