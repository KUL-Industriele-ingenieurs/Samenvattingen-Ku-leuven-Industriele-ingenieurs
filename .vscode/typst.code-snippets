{
    "Figure": {
        "prefix": "fig",
        "body": [
            "#figure(",
            "  image(\"${1:image.png}\", width: ${2:80%}),",
            "  caption: [${3:Caption}],",
            "  label: <fig:${4:label}>,",
            ")"
        ],
        "description": "Insert a figure with caption and label",
        "scope": "typst"
    },
    "Wrap Figure": {
        "prefix": "wrapfig",
        "body": [
            "#wrap-figure(",
            "  image(\"${1:image.png}\", width: 100%),",
            "  caption: [${2:Caption}],",
            "  label: <fig:${3:label}>,",
            "  width: ${4:5cm},",
            ")[",
            "  ${5:Content...}",
            "]"
        ],
        "description": "Insert a wrapped figure",
        "scope": "typst"
    },
    "Keyterm": {
        "prefix": "keyterm",
        "body": "#keyterm[$1]",
        "description": "Insert a keyterm with brackets",
        "scope": "typst"
    },
    "TODO": {
        "prefix": "todo",
        "body": "#TODO[$1]",
        "description": "Insert a TODO with brackets",
        "scope": "typst"
    },
    "NOTE": {
        "prefix": "note",
        "body": "#NOTE[$1]",
        "description": "Insert a NOTE with brackets",
        "scope": "typst"
    },
    "FIXME": {
        "prefix": "fixme",
        "body": "#FIXME[$1]",
        "description": "Insert a FIXME with brackets",
        "scope": "typst"
    },
    "Formula (frm)": {
        "prefix": "frm",
        "body": "#frm[$1][$2][$3]",
        "description": "Insert a formula with three sets of brackets",
        "scope": "typst"
    },
    "Theorie": {
        "prefix": "theorie",
        "body": "#theorie(title: \"$1\")[$2]",
        "description": "Insert a theorie block",
        "scope": "typst"
    },
    "Voorbeeld": {
        "prefix": "voorbeeld",
        "body": "#voorbeeld(title: \"$1\")[$2]",
        "description": "Insert a voorbeeld block",
        "scope": "typst"
    },
    "Concept": {
        "prefix": "concept",
        "body": "#concept(title: \"$1\")[$2]",
        "description": "Insert a concept block",
        "scope": "typst"
    },
    "Oefening": {
        "prefix": [
            "oefening",
            "oe"
        ],
        "body": "#oefening(title: \"$1\")[\n  $2\n]",
        "description": "Insert an exercise block with a title",
        "scope": "typst"
    },
    "Oplossing": {
        "prefix": [
            "sol",
            "oplossing"
        ],
        "body": "#oplossing[\n  $1\n]",
        "description": "Insert a solution block",
        "scope": "typst"
    }
}