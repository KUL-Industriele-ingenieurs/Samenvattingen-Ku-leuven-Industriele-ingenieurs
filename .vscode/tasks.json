{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LaTeX (latexmk - active file)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-shell-escape",
                "-interaction=nonstopmode",
                "-file-line-error",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build LaTeX (pdflatex single pass)",
            "type": "shell",
            "command": "pdflatex",
            "args": [
                "-interaction=nonstopmode",
                "-file-line-error",
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build main PDFs (latexmk)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-file-line-error",
                "math-systems/MATHSYS-Oefeningen-RubenRyckaert.tex"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Warmte PDF (latexmk)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-file-line-error",
                "Warmte en stromigen/Warmte en stromingen Samenvatting Ruben Ryckaert.tex"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build LaTeX (latexmk - template)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-file-line-error",
                "latex_templates/template_examples.tex"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build LaTeX (latexmk - active file)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-file-line-error",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Check @issue markers",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-NonInteractive",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\.vscode\\scripts\\check_issues.ps1"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-lc",
                    "${workspaceFolder}/.vscode/scripts/check_issues.sh"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-lc",
                    "${workspaceFolder}/.vscode/scripts/check_issues.sh"
                ]
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "latex-issues",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(info|warning|error):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Setup Git Hooks",
            "type": "shell",
            "command": "git",
            "args": ["config", "core.hooksPath", ".githooks"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "Clean LaTeX aux files",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "Get-ChildItem -Recurse -Include *.aux,*.log,*.out,*.toc,*.fdb_latexmk,*.fls,*.synctex.gz,*.synctex(busy),*.lof,*.lot,*.nav,*.snm,*.vrb,*.bbl,*.blg,*.bcf,*.run.xml,*.idx,*.ilg,*.ind | Remove-Item -Force; Write-Host 'LaTeX auxiliary files cleaned!' -ForegroundColor Green"
                ]
            },
            "linux": {
                "command": "find",
                "args": [
                    ".",
                    "-type",
                    "f",
                    "(",
                    "-name",
                    "*.aux",
                    "-o",
                    "-name",
                    "*.log",
                    "-o",
                    "-name",
                    "*.out",
                    "-o",
                    "-name",
                    "*.toc",
                    "-o",
                    "-name",
                    "*.fdb_latexmk",
                    "-o",
                    "-name",
                    "*.fls",
                    "-o",
                    "-name",
                    "*.synctex.gz",
                    "-o",
                    "-name",
                    "*.lof",
                    "-o",
                    "-name",
                    "*.lot",
                    "-o",
                    "-name",
                    "*.nav",
                    "-o",
                    "-name",
                    "*.snm",
                    "-o",
                    "-name",
                    "*.vrb",
                    "-o",
                    "-name",
                    "*.bbl",
                    "-o",
                    "-name",
                    "*.blg",
                    "-o",
                    "-name",
                    "*.bcf",
                    "-o",
                    "-name",
                    "*.run.xml",
                    "-o",
                    "-name",
                    "*.idx",
                    "-o",
                    "-name",
                    "*.ilg",
                    "-o",
                    "-name",
                    "*.ind",
                    ")",
                    "-delete",
                    "-print"
                ]
            },
            "osx": {
                "command": "find",
                "args": [
                    ".",
                    "-type",
                    "f",
                    "(",
                    "-name",
                    "*.aux",
                    "-o",
                    "-name",
                    "*.log",
                    "-o",
                    "-name",
                    "*.out",
                    "-o",
                    "-name",
                    "*.toc",
                    "-o",
                    "-name",
                    "*.fdb_latexmk",
                    "-o",
                    "-name",
                    "*.fls",
                    "-o",
                    "-name",
                    "*.synctex.gz",
                    "-o",
                    "-name",
                    "*.lof",
                    "-o",
                    "-name",
                    "*.lot",
                    "-o",
                    "-name",
                    "*.nav",
                    "-o",
                    "-name",
                    "*.snm",
                    "-o",
                    "-name",
                    "*.vrb",
                    "-o",
                    "-name",
                    "*.bbl",
                    "-o",
                    "-name",
                    "*.blg",
                    "-o",
                    "-name",
                    "*.bcf",
                    "-o",
                    "-name",
                    "*.run.xml",
                    "-o",
                    "-name",
                    "*.idx",
                    "-o",
                    "-name",
                    "*.ilg",
                    "-o",
                    "-name",
                    "*.ind",
                    ")",
                    "-delete",
                    "-print"
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Update school-macros.sty",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "Get-ChildItem -Directory -Recurse -Depth 2 | Where-Object { Get-ChildItem $_.FullName -Filter '*.tex' -ErrorAction SilentlyContinue } | ForEach-Object { Copy-Item 'school-macros.sty' $_.FullName -Force; Write-Host \"Copied to: $($_.FullName)\" }; Write-Host 'Update complete!' -ForegroundColor Green"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "find . -maxdepth 3 -type d -exec sh -c 'ls \"$1\"/*.tex >/dev/null 2>&1 && cp school-macros.sty \"$1/\" && echo \"Copied to: $1\"' _ {} \\; ; echo 'Update complete!'"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "find . -maxdepth 3 -type d -exec sh -c 'ls \"$1\"/*.tex >/dev/null 2>&1 && cp school-macros.sty \"$1/\" && echo \"Copied to: $1\"' _ {} \\; ; echo 'Update complete!'"
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
