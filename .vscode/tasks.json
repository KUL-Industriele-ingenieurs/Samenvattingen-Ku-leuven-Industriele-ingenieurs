{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Check @issue markers",
            "type": "shell",
            "windows": {
                "command": "Get-ChildItem -Recurse -Filter \"*.tex\" -ErrorAction SilentlyContinue | Select-String -Pattern '\u0040issue','\u0040todo','TODO','FIXME' | ForEach-Object { Write-Output ('{0}:{1}:1: warning: {2}' -f $_.Path, $_.LineNumber, ($_.Line.Trim())) }",
                "args": []
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "grep -rn --include='*.tex' -E '@issue|@todo|TODO|FIXME' . 2>/dev/null | while IFS=: read -r file line content; do echo \"$file:$line:1: warning: $content\"; done"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "grep -rn --include='*.tex' -E '@issue|@todo|TODO|FIXME' . 2>/dev/null | while IFS=: read -r file line content; do echo \"$file:$line:1: warning: $content\"; done"
                ]
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "latex-issues",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(info|warning|error):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Setup Git Hooks",
            "type": "shell",
            "command": "git",
            "args": ["config", "core.hooksPath", ".githooks"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "Clean LaTeX aux files",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "Get-ChildItem -Recurse -Include *.aux,*.log,*.out,*.toc,*.fdb_latexmk,*.fls,*.synctex.gz,*.synctex(busy),*.lof,*.lot,*.nav,*.snm,*.vrb,*.bbl,*.blg,*.bcf,*.run.xml,*.idx,*.ilg,*.ind | Remove-Item -Force; Write-Host \"LaTeX auxiliary files cleaned!\" -ForegroundColor Green"
                ]
            },
            "linux": {
                "command": "find",
                "args": [
                    ".",
                    "-type",
                    "f",
                    "(",
                    "-name",
                    "*.aux",
                    "-o",
                    "-name",
                    "*.log",
                    "-o",
                    "-name",
                    "*.out",
                    "-o",
                    "-name",
                    "*.toc",
                    "-o",
                    "-name",
                    "*.fdb_latexmk",
                    "-o",
                    "-name",
                    "*.fls",
                    "-o",
                    "-name",
                    "*.synctex.gz",
                    "-o",
                    "-name",
                    "*.lof",
                    "-o",
                    "-name",
                    "*.lot",
                    "-o",
                    "-name",
                    "*.nav",
                    "-o",
                    "-name",
                    "*.snm",
                    "-o",
                    "-name",
                    "*.vrb",
                    "-o",
                    "-name",
                    "*.bbl",
                    "-o",
                    "-name",
                    "*.blg",
                    "-o",
                    "-name",
                    "*.bcf",
                    "-o",
                    "-name",
                    "*.run.xml",
                    "-o",
                    "-name",
                    "*.idx",
                    "-o",
                    "-name",
                    "*.ilg",
                    "-o",
                    "-name",
                    "*.ind",
                    ")",
                    "-delete",
                    "-print"
                ]
            },
            "osx": {
                "command": "find",
                "args": [
                    ".",
                    "-type",
                    "f",
                    "(",
                    "-name",
                    "*.aux",
                    "-o",
                    "-name",
                    "*.log",
                    "-o",
                    "-name",
                    "*.out",
