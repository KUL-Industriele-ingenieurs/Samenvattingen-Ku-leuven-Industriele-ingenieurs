{
  "latex-workshop.linting.enabled": true,
  "latex-workshop.linting.ignore": [
    "**/*.aux",
    "**/*.toc",
    "**/*.out",
    "**/*.fls",
    "**/*.fdb_latexmk",
    "**/*.synctex.gz",
    "**/*.log",
    "**/Thumbs.db"
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DOCFILE%"
      ],
      "env": {}
    }
  ],

  // LaTeX Utilities: paste-image configuration
  "latex-utilities.formattedPaste.image.template": "\\begin{figure}[ht]\\n  \\centering\\n  \\includegraphics[width=0.8\\textwidth]{${imageFilePath}}\\n  \\caption{${imageCaption}}\\n  \\label{fig:${imageFileName}}\\n\\end{figure}",
  "latex-utilities.formattedPaste.image.path": "Productietechnologie/assets",
  "latex-utilities.formattedPaste.enabled": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex × 2 (fast)",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "latexmk (pdflatex)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatex",
      "tools": [
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.fdb_latexmk",
    "*.dpth",
    "*.md5",
    "*.auxlock"
  ],

  // GitHub Issues integration
  "githubIssues.queries": [
    {
      "label": "My Issues",
      "query": "is:open is:issue assignee:@me repo:${owner}/${repository}"
    },
    {
      "label": "Created Issues",
      "query": "is:open is:issue author:@me repo:${owner}/${repository}"
    },
    {
      "label": "All Open Issues",
      "query": "is:open is:issue repo:${owner}/${repository}"
    },
    {
      "label": "@issue markers (from-code)",
      "query": "is:open is:issue label:from-code repo:${owner}/${repository}"
    }
  ],
  "githubIssues.createIssueTriggers": [
    "@issue",
    "TODO",
    "FIXME"
  ],
  "githubIssues.useBranchForIssues": true,
  "githubIssues.issueBranchTitle": "issue${issueNumber}",
  "githubIssues.issueCompletionFormatScm": "#${issueNumber}",
  "githubIssues.workingIssueFormatScm": "#${issueNumber}",

  // Todo Tree configuration for @issue markers
  "todo-tree.general.tags": [
    "@issue",
    "TODO",
    "FIXME",
    "NOTE",
    "BUG"
  ],
  "todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^|%|^[ \\t]*(-|\\*))\\s*($TAGS)|^\\s*- \\[ \\])",
  "todo-tree.regex.regexCaseSensitive": false,
  "todo-tree.highlights.defaultHighlight": {
    "icon": "issue-opened",
    "type": "text",
    "foreground": "#ffffff",
    "background": "#ffab70",
    "opacity": 50,
    "iconColour": "#ffab70"
  },
  "todo-tree.highlights.customHighlight": {
    "@issue": {
      "icon": "checklist",
      "iconColour": "#FFD700",
      "foreground": "#FFD700",
      "background": "#4A4A4A",
      "type": "text-and-comment"
    },
    "TODO": {
      "icon": "check",
      "iconColour": "#00ff00"
    },
    "FIXME": {
      "icon": "alert",
      "iconColour": "#ff0000"
    },
    "BUG": {
      "icon": "bug",
      "iconColour": "#ff0000"
    }
  },
  "todo-tree.general.showActivityBarBadge": true,
  "todo-tree.general.statusBar": "tags",
  "todo-tree.filtering.includeGlobs": [
    "**/*.tex",
    "**/*.md",
    "**/*.py"
  ]
}
