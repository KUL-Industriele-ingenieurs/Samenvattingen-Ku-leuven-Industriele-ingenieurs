{
  "latex-workshop.linting.enabled": true,
  "latex-workshop.linting.ignore": [
    "**/*.aux",
    "**/*.toc",
    "**/*.out",
    "**/*.fls",
    "**/*.fdb_latexmk",
    "**/*.synctex.gz",
    "**/*.log",
    "**/Thumbs.db"
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DOCFILE%"
      ],
      "env": {}
    }
  ],

  // LaTeX Utilities: paste-image configuration
  "latex-utilities.formattedPaste.image.template": "begin{figure}[ht]\n  \\centering\n  \\includegraphics[width=0.8\\textwidth]{${imageFilePath}}\n  \\caption{${imageCaption}}\n  \\label{fig:${imageFileName}}\n\\end{figure}",
  "latex-utilities.formattedPaste.enabled": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex × 2 (fast)",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "latexmk (pdflatex)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatex",
      "tools": [
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.fdb_latexmk",
    "*.dpth",
    "*.md5",
    "*.auxlock",
    "*.log",
    "*.synctex.gz"
  ],

  "files.exclude": {
    "**/*.log": true,
    "**/*.synctex.gz": true
  },

  // GitHub Pull Requests & Issues extension settings
  "githubPullRequests.queries": [
    {
      "label": "Waiting For My Review",
      "query": "is:open is:pr review-requested:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    },
    {
      "label": "Assigned To Me",
      "query": "is:open is:pr assignee:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    },
    {
      "label": "Created By Me",
      "query": "is:open is:pr author:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    },
    {
      "label": "All Open Pull Requests",
      "query": "is:open is:pr repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    }
  ],
  "githubPullRequests.createOnPublishBranch": "never",
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.remotes": [
    "origin"
  ],

  "githubIssues.queries": [
    {
      "label": "📍 Code Location Markers",
      "query": "is:open is:issue label:from-code repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    },
    {
      "label": "Assigned Issues",
      "query": "is:open is:issue assignee:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
    },
    {
      "label": "My Issues",
      "query": "is:open is:issue assignee:${user} repo:${owner}/${repository}",
      "groupBy": [
        "milestone"
      ]
    },
    {
      "label": "Created Issues",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
    },
    {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
    }
  ],

  "githubIssues.createIssueTriggers": [
    " @issue", " @todo", " @bug", " @feature", " @refactor", "TODO", "FIXME"
  ],
  "githubIssues.useBranchForIssues": true,
  "githubIssues.issueBranchTitle": "issue-${issueNumber}",

}
