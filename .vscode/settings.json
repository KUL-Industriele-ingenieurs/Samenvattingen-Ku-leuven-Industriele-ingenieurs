                                    "mode": "replace",
                                    "argument": {
                                        "start": "$ ",
                                        "end": " $"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Fraction",
                            "icon": "divide",
                            "description": "Insert fraction (frac)",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "frac(",
                                        "end": ", )"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Matrix",
                            "icon": "grid",
                            "description": "Insert matrix",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "mat(",
                                        "end": ")"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
