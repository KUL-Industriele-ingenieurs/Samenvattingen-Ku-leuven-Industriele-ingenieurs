{
    "tinymist.fontPaths": ["./fonts", "${workspaceFolder}/fonts", "fonts"],
    "tinymist.exportPdf": "never",
    "tinymist.formatterMode": "typstyle",
    "[typst]": {
        "editor.formatOnSave": true,
        "editor.wordWrap": "on",
        "editor.wordBasedSuggestions": "allDocuments",
        "editor.snippetSuggestions": "top",
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "[latex]": {
        "editor.wordBasedSuggestions": "allDocuments",
        "editor.snippetSuggestions": "top",
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "latex-workshop.linting.chktex.enabled": false,
    "latex-workshop.linting.lacheck.enabled": false,
    "latex.linter.enabled": false,
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-shell-escape",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-shell-escape",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": ["%DOCFILE%"],
            "env": {}
        }
    ],
    "latex-utilities.formattedPaste.imagePathOverride": "${currentFileDir}/assets",
    "latex-utilities.formattedPaste.image.template": "\\begin{figure}[htbp]\n  \\centering\n  \\includegraphics[width=0.8\\textwidth]{assets/${imageFileName}}\n  \\caption{${imageFileNameWithoutExt}}\n  \\label{fig:${imageFileNameWithoutExt}}\n\\end{figure}",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": ["latexmk"]
        }
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.message.error.show": true,
    "latex-workshop.message.warning.show": true,
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.fdb_latexmk",
        "*.dpth",
        "*.md5",
        "*.auxlock",
        "*.log",
        "*.synctex.gz"
    ],
    "githubPullRequests.queries": [
        {
            "label": "Local Pull Request Branches",
            "query": "default"
        },
        {
            "label": "Waiting For My Review",
            "query": "is:open is:pr review-requested:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
        },
        {
            "label": "Assigned To Me",
            "query": "is:open is:pr assignee:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
        },
        {
            "label": "Created By Me",
            "query": "is:open is:pr author:${user} repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
        },
        {
            "label": "All Open Pull Requests",
            "query": "is:open is:pr repo:Eggmansmile/Samenvattingen-Ku-leuven-Industriele-ingenieurs"
        },
        {
            "label": "All Open",
            "query": "default"
        }
    ],
    "githubPullRequests.createOnPublishBranch": "never",
    "githubPullRequests.defaultMergeMethod": "merge",
    "githubPullRequests.remotes": ["origin"],
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "is:open is:issue assignee:@me repo:${owner}/${repository}"
        },
        {
            "label": "Created Issues",
            "query": "is:open is:issue author:@me repo:${owner}/${repository}"
        },
        {
            "label": "All Open Issues",
            "query": "is:open is:issue repo:${owner}/${repository}"
        },
        {
            "label": "@issue markers",
            "query": "is:open is:issue label:from-code repo:${owner}/${repository}"
        }
    ],
    "githubIssues.createIssueTriggers": [
        "@issue",
        "@todo",
        "@bug",
        "@feature",
        "@refactor",
        "TODO",
        "FIXME"
    ],
    "githubIssues.useBranchForIssues": "on",
    "githubIssues.issueBranchTitle": "issue${issueNumber}",
    "githubIssues.issueCompletionFormatScm": "#${issueNumber}",
    "githubIssues.workingIssueFormatScm": "#${issueNumber}",
    "latex-workshop.latex.build.forceRecipeUsage": false,
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.intellisense.command.user": {
        "concept": "concept{${1:term}}",
        "belangrijk": "belangrijk{${1:text}}",
        "keyterm": "keyterm{${1:term}}",
        "frm": "frm{${1:title}}{${2:formula}}{${3:description}}",
        "sym": "sym{${1:symbol}}{${2:description}}{${3:unit}}",
        "mat": "mat{${1:matrix_content}}",
        "TODO": "TODO{${1:message}}",
        "FIXME": "FIXME{${1:message}}",
        "NOTE": "NOTE{${1:message}}",
        "citeme": "citeme",
        "kuleuventitle": "kuleuventitle{${1:Title}}{${2:Course}}{${3:Name}}{${4:Year}}",
        "dd": "dd{${1:y}}{${2:x}}",
        "ddn": "ddn{${1:y}}{${2:x}}{${3:n}}",
        "pd": "pd{${1:y}}{${2:x}}",
        "pdn": "pdn{${1:y}}{${2:x}}{${3:n}}",
        "dv": "dv[${1:n}]{${2:y}}{${3:x}}",
        "pdv": "pdv[${1:n}]{${2:y}}{${3:x}}",
        "uvec": "uvec{${1:vector}}",
        "abs": "abs{${1:value}}",
        "norm": "norm{${1:vector}}",
        "paren": "paren{${1:content}}",
        "bracket": "bracket{${1:content}}",
        "curlybrace": "curlybrace{${1:content}}",
        "avg": "avg{${1:value}}",
        "plotthreeD": "plotthreeD[${1:options}]{${2:options}}{${3:function}}",
        "plotdata": "plotdata[${1:options}]{${2:col_mapping}}{${3:filename.csv}}",
        "begintwocol": "begintwocol",
        "endtwocol": "endtwocol",
        "theorie": "theorie",
        "theorieblok": "theorieblok",
        "schoolconcept": "schoolconcept",
        "conceptbox": "conceptbox",
        "waarschuwing": "waarschuwing",
        "warningbox": "warningbox",
        "voorbeeld": "voorbeeld",
        "oefenblok": "oefenblok",
        "oefening": "oefening",
        "codeblock": "codeblock",
        "examenbox": "examenbox"
    },
    "files.exclude": {
        "**/*.log": true,
        "**/*.aux": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // --- Paste Image Configuration ---
    "pasteImage.showFilePathConfirmInputBox": true,
    "pasteImage.path": "${currentFileDir}/assets",
    "pasteImage.basePath": "${currentFileDir}",
    "pasteImage.forceUnixStyleSeparator": true,
    "pasteImage.prefix": "",
    "pasteImage.insertPattern": "#figure(\n  image(\"assets/${imageFileName}\", width: 5cm),\n  caption: [${imageFileNameWithoutExt}],\n  label: <fig:${imageFileNameWithoutExt}>,\n)",
    "pasteImage.filePathConfirmInputBoxMode": "onlyName",
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestionsDelay": 10,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "typst": true
    },
    "github.copilot.editor.enableAutoCompletions": false,
    "typst-companion.extension.list.indentationSize": "adaptive",
    "typst-companion.extension.orderedList.autoRenumber": true,
    "toolbar.builtin.latex.activate": false,
    "toolbar.panel.languages": [
        "markdown",
        "latex",
        "typst"
    ],
    "toolbar.toolboxs": [
        {
            "name": "Typst Academic Tools",
            "view": "latex",
            "activate": {
                "hover": false,
                "languages": [
                    "typst"
                ]
            },
            "layers": [
                {
                    "name": "Drawing & Images",
                    "icon": "paintcan",
                    "tools": [
                        {
                            "name": "New Excalidraw",
                            "icon": "paintcan",
                            "actions": [
                                {
                                    "command": "workbench.action.tasks.runTask",
                                    "argument": "New Excalidraw drawing",
                                    "mode": "command"
                                }
                            ]
                        },
                        {
                            "name": "Paste Image",
                            "icon": "desktop-download",
                            "actions": [
                                {
                                    "command": "extension.pasteImage",
                                    "mode": "command"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Blocks & Layout",
                    "icon": "symbol-unit",
                    "tools": [
                        {
                            "name": "Insert Table",
                            "icon": "table",
                            "description": "Insert a standard table",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "#table(\n  columns: (${1:1fr, 1fr}),\n  [${2:Header 1}], [${3:Header 2}],\n  [${4:Cell 1}], [${5:Cell 2}],\n)$0"
                                }
                            ]
                        },
                        {
                            "name": "Grid",
                            "icon": "symbol-grid",
                            "description": "Insert a layout grid",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "#grid(\n  columns: (${1:1fr, 1fr}),\n  gutter: ${2:1em},\n  [${3:Left}], [${4:Right}],\n)$0"
                                }
                            ]
                        },
                        {
                            "name": "Rectangle Box",
                            "icon": "record",
                            "description": "Insert rectangle box",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "#rect(width: ${1:100%}, stroke: ${2:0.5pt}, inset: ${3:8pt})[\n  $0\n]"
                                }
                            ]
                        },
                        {
                            "name": "Code Block",
                            "icon": "code",
                            "description": "Insert code block",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "```${1:rust}\n",
                                        "end": "\n```"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Document Structure",
                    "icon": "$H",
                    "tools": [
                        {
                            "name": "Heading 1",
                            "icon": "$①",
                            "description": "Heading level 1",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "= "
                                }
                            ]
                        },
                        {
                            "name": "Heading 2",
                            "icon": "$②",
                            "description": "Heading level 2",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "== "
                                }
                            ]
                        },
                        {
                            "name": "Heading 3",
                            "icon": "$③",
                            "description": "Heading level 3",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "=== "
                                }
                            ]
                        },
                        {
                            "name": "Unordered List",
                            "icon": "list-unordered",
                            "description": "Bullet list item",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "- "
                                }
                            ]
                        },
                        {
                            "name": "Ordered List",
                            "icon": "list-ordered",
                            "description": "Numbered list item",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": "+ "
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Formatting",
                    "icon": "pencil",
                    "tools": [
                        {
                            "name": "Toggle Bold",
                            "icon": "$🄱",
                            "description": "Toggle bold text",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "*",
                                        "end": "*"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Toggle Italic",
                            "icon": "$🄸",
                            "description": "Toggle italic text",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "_",
                                        "end": "_"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Toggle Monospace",
                            "icon": "bracket",
                            "description": "Toggle inline code / monospace",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "`",
                                        "end": "`"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "Math & Formulas",
                    "icon": "$α",
                    "tools": [
                        {
                            "name": "Inline Math",
                            "icon": "#F{$}",
                            "description": "Toggle inline formula",
                            "activate": true,
                            "actions": [
                                {
                                    "mode": "replace",
                                    "argument": {
                                        "start": "$",
                                        "end": "$"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Block Math",
                            "icon": "#F{$$}",
