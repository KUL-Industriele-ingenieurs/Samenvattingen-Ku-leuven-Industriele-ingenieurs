% Verwijzingen dragen hun betekenis via kleur (linkcolor=schoolBlue hierboven).
% Hier stond een \renewcommand die elke \ref onderstreepte. Op papier leest dat
% als een kapotte hyperlink, het botste met de liniaal onder elke \section, en
% \cref werd niet onderstreept -- dus het was ook nog inconsistent.

% ============================================================================ 
%                           TCOLORBOX ARCHITECTURE
% ============================================================================ 

\tcbset{
    % xshift=0mm: de titeltab lijnt uit op de linkerrand van de body. Stond op
    % 5mm, waardoor tekst, boxbody en boxtitel drie verschillende linkerranden
    % hadden. `drop fuzzy shadow` is weg: een slagschaduw onder elke box is het
    % meest gedateerde element op de pagina en voegt niets toe op papier.
    schoolbox/.style={ 
        enhanced, breakable,
        arc=2pt, boxrule=0.5pt,
        attach boxed title to top left={xshift=0mm, yshift*=-\tcboxedtitleheight},
        boxed title style={sharp corners, rounded corners=north, boxrule=0pt, colback=#1},
        colframe=#1, colback=white,
        fonttitle=\bfseries\sffamily,
        before skip=12pt,
        after skip=12pt
    },
    schoolstyle/.style={schoolbox=schoolBlue},
    schoolbase/.style={
        blanker, breakable, left=12pt, borderline west={3pt}{0pt}{schoolBlue}
    },
    schoolshadow/.style={
        drop fuzzy shadow={opacity=0.15, shadow xshift=0.5mm, shadow yshift=-0.5mm}
    },
    schoolTitle/.code n args={3}{%
        \ifstrempty{#1}{}{%
            \tcbset{title={#2 \textbf{#3} #1}}%
        }%
    },
    schoolTitleSimple/.code n args={2}{%
        \ifstrempty{#1}{}{%
            \tcbset{title={#2 \textbf{#1}}}%
        }%
    }
}

