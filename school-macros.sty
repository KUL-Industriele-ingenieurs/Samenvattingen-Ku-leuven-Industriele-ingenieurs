% Gelijk aan de marges in school-template.typ.
\geometry{left=1.5cm, right=1.5cm, top=2.0cm, bottom=2.0cm}

\newif\ifcompactmode
\newcommand{\enablecompactmode}{
    % Stond op exact dezelfde waarden als de default \geometry hierboven,
    % waardoor compact mode niets aan de bladspiegel veranderde.
    \geometry{left=1.5cm, right=1.5cm, top=2.0cm, bottom=2.0cm}
    \setlist{noitemsep, topsep=0pt, parsep=0pt, partopsep=0pt}
    \setlength{\parskip}{0.3em}
    \setlength{\parindent}{0pt}
    \titlespacing*{\section}{0pt}{0.5em}{0.2em}
    \titlespacing*{\subsection}{0pt}{0.3em}{0.1em}
    
    % Compact Math Spacing
    \setlength{\abovedisplayskip}{4pt plus 2pt minus 2pt}
    \setlength{\belowdisplayskip}{4pt plus 2pt minus 2pt}
    \setlength{\abovedisplayshortskip}{0pt plus 2pt}
    \setlength{\belowdisplayshortskip}{2pt plus 2pt minus 1pt}

    % Compact Box Spacing
    \tcbset{before skip=6pt, after skip=6pt}

    \fancyhf{}
