% Zelfde vorm als het disclaimer-blok in school-template.typ: lichte vulling,
% 3pt blauwe balk links, afgeronde hoeken. De standaard abstract-omgeving was
% een gecentreerde kop met smalle marges en zag er totaal anders uit dan de
% Typst-kant. Bestaande documenten met \begin{abstract} krijgen dit vanzelf.
\newtcolorbox{schoolintro}{
    enhanced, breakable,
    colback=black!2, colframe=black!2,
    borderline west={3pt}{0pt}{schoolBlue},
    arc=4pt, boxrule=0pt,
    left=12pt, right=12pt, top=10pt, bottom=10pt,
    before skip=12pt, after skip=16pt,
    % Niet uitvullen: de GitHub-URL is een lang onbreekbaar woord en trok in
    % uitgevulde tekst gaten van een halve regel breed.
    fontupper=\raggedright,
}
\renewenvironment{abstract}{\begin{schoolintro}}{\end{schoolintro}}

% Hoeveel hoofdtitels in de linkermarge steken. Op 0pt zetten schakelt het uit.
\newlength{\schoolTitleOutdent}
\setlength{\schoolTitleOutdent}{0.9em}

% Section Styling
\ifcsdef{chapter}{ 
    \titleclass{\chapter}{straight}
    \titleformat{\chapter}[hang]{\normalfont\LARGE\bfseries\sffamily}{\thechapter}{0.5em}{}[\titlerule]
    \titleformat{name=\chapter,numberless}[hang]{\normalfont\LARGE\bfseries\sffamily}{}{0pt}{}[\titlerule]
    % Negatieve linkerinspring: hoofdtitels steken iets in de marge, zodat de
    % structuur al zichtbaar is als je door het document bladert.
    \titlespacing*{\chapter}{-\schoolTitleOutdent}{14pt}{6pt}
    \preto{\chapter}{\FloatBarrier}
}{}

% De derde parameter van \titleformat is de ruimte tussen nummer en titel.
% Die stond op 1em; bij \LARGE is dat ~17pt en dat gaapte zichtbaar. Nu 0.5em,
% gelijk aan de h(0.5em) in de heading rules van school-template.typ.
%
% Alleen \section krijgt een liniaal. Een genummerde \subsection had er geen,
% een ongenummerde wel -- dat was al inconsistent -- en met een liniaal onder
% beide niveaus viel het verschil tussen \section en \subsection weg.
\titleformat{\section}[hang]{\normalfont\Large\bfseries\sffamily\raggedright}{\thesection}{0.5em}{}[\titlerule]
\titleformat{name=\section,numberless}[hang]{\normalfont\Large\bfseries\sffamily\raggedright}{}{0pt}{}[\titlerule]
\titleformat{name=\subsection,numberless}[hang]{\normalfont\large\bfseries\sffamily\raggedright}{}{0pt}{}
\titlespacing*{\section}{-\schoolTitleOutdent}{14pt}{6pt}

\titleformat{\subsection}[hang]{\normalfont\large\bfseries\sffamily\raggedright}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

% Float Control
% Ruimer dan de 6-8pt die hier stond. Met zulke krappe waarden kon LaTeX twee
% [ht]-floats plus tekst op een pagina persen; in combinatie met \FloatBarrier
% werden die floats er dan uitgeduwd bovenop de lopende tekst.
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{16pt plus 2pt minus 4pt}
\setlength{\intextsep}{12pt plus 2pt minus 2pt}

% Hoeveel van een pagina floats mogen innemen. Zonder deze grenzen laat LaTeX
% een pagina toe die vrijwel volledig uit floats bestaat.
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.70}
\renewcommand{\textfraction}{0.10}
\renewcommand{\floatpagefraction}{0.75}

% Caption Styling
\captionsetup{skip=3pt,aboveskip=3pt,belowskip=3pt,font={small,sf},labelfont=bf}

% List Styling (Tightened for summaries)
\setlist[itemize,1]{leftmargin=2em,itemsep=0.3ex,parsep=0.3ex,partopsep=0.5ex,topsep=0.5ex}
\setlist[enumerate,1]{leftmargin=2em,itemsep=0.3ex,parsep=0.3ex,partopsep=0.5ex,topsep=0.5ex}

