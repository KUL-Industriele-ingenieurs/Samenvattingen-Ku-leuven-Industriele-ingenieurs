% \IfFileExists doorzoekt \graphicspath niet, dus het logo wordt hier expliciet
% op de bekende relatieve dieptes gezocht. Ontbreekt het, dan valt de titelpagina
% terug op de tekstversie i.p.v. te breken.
\makeatletter
\newcommand*{\schoolLogoPath}{}
\newcommand*{\schoolFindLogo}{%
    \let\schoolLogoPath\@empty
    \@for\school@dir:={assets,../assets,../../assets,../../../assets}\do{%
        \ifx\schoolLogoPath\@empty
            \edef\school@try{\school@dir/Ku Leuven logo.png}%
            \IfFileExists{\school@try}{\let\schoolLogoPath\school@try}{}%
        \fi
    }%
}
\makeatother

% Zelfde opbouw als de titelpagina in school-template.typ: verdeling met
% \vfill i.p.v. vaste sprongen, blauwe scheidingslijn, vak en jaartal grijs,
% en het KU Leuven-logo (via \graphicspath hierboven vanaf elke mapdiepte).
\makeatletter
% Ondertitel (vak / "Samenvatting"). Leeg tenzij gezet.
\newcommand*{\schoolsubtitle}{}
\@ifundefined{subtitle}{%
    \newcommand*{\subtitle}[1]{\renewcommand*{\schoolsubtitle}{#1}}%
}{}

% Titelpagina, zelfde opbouw als in school-template.typ: verdeling met \vfill,
% blauwe scheidingslijn, ondertitel en datum grijs, en het KU Leuven-logo.
% Dit vervangt de standaard \maketitle, zodat documenten die \title/\author
% gebruiken dezelfde pagina krijgen als documenten met \kuleuventitle -- die
% twee zagen er tot nu toe volledig verschillend uit.
\renewcommand{\maketitle}{%
    \begin{titlepage}
        \centering
        \sffamily
        \vspace*{0pt}%
        \vfill\vfill\vfill
        {\Huge\bfseries \@title\par}
        \ifx\schoolsubtitle\@empty\else
            \vspace{0.7cm}{\Large\color{black!60}\schoolsubtitle\par}%
        \fi
        \vspace{0.9cm}%
        {\color{schoolBlue}\rule{0.35\linewidth}{1pt}\par}
        \vspace{0.9cm}%
        {\large \@author\par}
        \vspace{0.35cm}%
        {\large\color{black!60}\@date\par}
        \vfill\vfill\vfill\vfill
        \schoolFindLogo
        \ifx\schoolLogoPath\@empty\else
            \includegraphics[width=0.38\linewidth]{\schoolLogoPath}\par
            \vspace{0.8cm}%
        \fi
        {KU Leuven\par}
        {\small\color{black!60} Faculteit Industriële Ingenieurswetenschappen\par}
        \vfill\vfill
    \end{titlepage}
}

% Dunne wrapper: titel, vak, auteur, jaar -> dezelfde titelpagina.
\NewDocumentCommand{\kuleuventitle}{ m m m m }{%
    \title{#1}\subtitle{#2}\author{#3}\date{#4}\maketitle
}
\makeatother

