% --- Codefont: JetBrains Mono waar het kan, anders Fira Mono ---------------
% JetBrains Mono bestaat in TeX Live enkel als OTF en heeft dus fontspec nodig
% (LuaLaTeX of XeLaTeX). Onder pdflatex vallen we terug op Fira Mono, dat er
% sterk op lijkt en wel als Type1 beschikbaar is. Zo blijft het document met
% elke engine compileren.
\RequirePackage{iftex}
\ifPDFTeX
    \@ifpackageloaded{FiraMono}{}{\RequirePackage[scaled=0.85]{FiraMono}}
\else
    \@ifpackageloaded{fontspec}{}{\RequirePackage{fontspec}}
    \IfFontExistsTF{JetBrainsMono-Regular.otf}{
        \setmonofont{JetBrainsMono}[
            Extension      = .otf,
            UprightFont    = *-Regular,
            BoldFont       = *-Bold,
            ItalicFont     = *-Italic,
            BoldItalicFont = *-BoldItalic,
            Scale          = 0.85,
        ]
    }{
        \@ifpackageloaded{FiraMono}{}{\RequirePackage[scaled=0.85]{FiraMono}}
    }
\fi

% `spacing` (en font expansion) bestaan alleen in pdftex. Onder LuaLaTeX of
% XeLaTeX gaf microtype daarop een error en werd er geen PDF geproduceerd --
% net de engines waar de JetBrains Mono-tak hierboven om vraagt.
\@ifpackageloaded{microtype}{}{
    \ifPDFTeX
        \RequirePackage[
            activate={true,nocompatibility},
            final,
            tracking=true,
            kerning=true,
            spacing=true,
            factor=1100,
            stretch=10,
            shrink=10,
            letterspace=50
        ]{microtype}
    \else
        % Alleen protrusion + tracking werken buiten pdftex; kerning/spacing
        % geven daar een error i.p.v. een waarschuwing.
        \RequirePackage[
            activate={true,nocompatibility},
            final,
            tracking=true,
            kerning=false,
            spacing=false,
            letterspace=50
        ]{microtype}
    \fi
}
