\newtcblisting{codeblock}[2][]{%
    enhanced, breakable,
    colback=codeBackground,
    colframe=codeBorder,
    boxrule=0.6pt,
    arc=2pt,
    colupper=codeText,
    left=3mm, right=2mm, top=2mm, bottom=2mm,
    listing only,
    listing engine=listings,
    listing options={
        language=#2,
        basicstyle=\ttfamily\footnotesize\color{codeText},
        keywordstyle=\color{codeKeyword}\bfseries,
        stringstyle=\color{codeString},
        commentstyle=\color{codeComment}\itshape,
        numberstyle=\tiny\color{codeLineNo},
        numbers=left, numbersep=8pt,
        breaklines=true, breakatwhitespace=true,
        breakindent=2em,
        columns=fullflexible, keepspaces=true,
        tabsize=4,
        showstringspaces=false,
        extendedchars=true,
        aboveskip=0pt, belowskip=0pt
    },
    % Titelbalk: lichte strook met een accentlijn eronder
    % Custom titel? Toon die en zet de taal er als kleine tag achter.
    % Geen titel? Dan volstaat de taal zelf.
    title={\textcolor{schoolBlue}{\faCode}\ \ifstrempty{#1}%
           {\texttt{#2}}%
           {\textbf{#1}\ \textcolor{codeComment}{\scriptsize\texttt{[#2]}}}},
    coltitle=codeText,
    colbacktitle=codeTitleBar,
    fonttitle=\sffamily\bfseries\small,
    % Titelbalk over de volle breedte, zoals de editor-titelbalk in
    % school-template.typ. Dit was een losse tab die met een zichtbaar gat
    % boven de body zweefde en een andere afronding had dan de schoolbox-tabs.
    titlerule=0pt,
    top=2mm,
}

