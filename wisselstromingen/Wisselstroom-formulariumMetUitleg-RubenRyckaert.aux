\@writefile{toc}{\contentsline {section}{\numberline {1}Inleiding}{5}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Hoofdstuk 1: Basis wisselstroom theorie}{5}{section.2}\protected@file@percent }
\newlabel{frm:1}{{2}{5}{Hoofdstuk 1: Basis wisselstroom theorie}{section.2}{}}
\addformulariumentry{0}{Wet van Ohm}{V = I \cdot R}{Met V de spanning in Volt, I de stroom in Ampère en R de weerstand in Ohm.}{1}
\newlabel{frm:2}{{2}{5}{Hoofdstuk 1: Basis wisselstroom theorie}{section.2}{}}
\addformulariumentry{0}{$I(t)$}{I(t) = I_m \sin (\omega t)}{Met $I(t)$ de wisselstroom op tijdstip t, $I_m$ de piekstroom (maximale stroom) en $\omega $ de hoeksnelheid in rad/s.}{2}
\newlabel{frm:3}{{2}{5}{Hoofdstuk 1: Basis wisselstroom theorie}{section.2}{}}
\addformulariumentry{0}{$V(t)$}{V(t) = V_m \sin (\omega t)}{Met $V(t)$ de wisselspanning op tijdstip t, $V_m$ de piekspannin g (maximale spanning) en $\omega $ de hoeksnelheid in rad/s.}{3}
\newlabel{frm:4}{{2}{5}{Hoofdstuk 1: Basis wisselstroom theorie}{section.2}{}}
\addformulariumentry{0}{$A_{gem}$}{A_{gem} = \frac  {1}{T/2} \DOTSI \intop \ilimits@ _0^{T/2} A(t) dt}{Met $A_{gem}$ de gemiddelde waarde van A(t) over een halve periode T. Dit is handig voor wisselspanningen en -stromen omdat ze gemiddeld gezien 0 zijn over een hele periode. De gemiddelde waarde geeft een beter idee van de effectieve grootte van de wisselstroom.}{4}
\newlabel{frm:5}{{2}{5}{Hoofdstuk 1: Basis wisselstroom theorie}{section.2}{}}
\addformulariumentry{0}{$A_{rms}$}{A_{rms} = \sqrt  {\frac  {1}{T} \DOTSI \intop \ilimits@ _0^T A^2(t) dt}}{Met $A_{rms}$ de effectieve waarde van A(t). Dit is de waarde die je zou meten met een multimeter.}{5}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}fasors}{6}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Weergave van een fasor in het complexe vlak. De fasor $\mathbf  {V}$ heeft een amplitude $V_m$ en een fasehoek $\phi $. Het reële deel is $V \cos \phi $ en het imaginaire deel is $V \sin \phi $.}}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fasor}{{1}{6}{Weergave van een fasor in het complexe vlak. De fasor $\vec {V}$ heeft een amplitude $V_m$ en een fasehoek $\phi $. Het reële deel is $V \cos \phi $ en het imaginaire deel is $V \sin \phi $}{figure.caption.1}{}}
\newlabel{frm:6}{{2.1}{6}{fasors}{figure.caption.1}{}}
\addformulariumentry{0}{fasor}{\mathbf  {A} = A_m \angle \phi = A_m (\cos \phi + j \sin \phi ) =A_m e^{j\phi }}{Met $\mathbf  {A}$ de fasor van de wisselgrootte A, $A_m$ de amplitude (piekwaarde) en $\phi $ de fasehoek in radialen. Het reële deel is $A_m \cos \phi $ en het imaginaire deel is $A_m \sin \phi $. }{6}
\@writefile{toc}{\contentsline {section}{\numberline {3}Hoofdstuk 2: Wisselstroom ketens}{7}{section.3}\protected@file@percent }
\newlabel{frm:7}{{3}{7}{Hoofdstuk 2: Wisselstroom ketens}{section.3}{}}
\addformulariumentry{0}{Impedantie}{Z = R + jX}{Met Z de impedantie in Ohm, R de weerstand in Ohm en X de reactantie in Ohm.}{7}
\newlabel{frm:8}{{3}{7}{Hoofdstuk 2: Wisselstroom ketens}{section.3}{}}
\addformulariumentry{0}{Reactantie spoel}{X_L = \omega L}{Met $X_L$ de inductieve reactantie in Ohm, $\omega $ de hoeksnelheid in rad/s en L de inductantie in Henry.}{8}
\newlabel{frm:9}{{3}{7}{Hoofdstuk 2: Wisselstroom ketens}{section.3}{}}
\addformulariumentry{0}{Reactantie condensator}{X_C = \frac  {-1}{\omega C}}{Met $X_C$ de capacatieve reactantie in Ohm, $\omega $ de hoeksnelheid in rad/s en C de capaciteit in Farad.}{9}
\newlabel{frm:10}{{3}{7}{Hoofdstuk 2: Wisselstroom ketens}{section.3}{}}
\addformulariumentry{0}{Totale impedantie in serie}{Z_{totaal} = \sqrt  {R^2 + (X_L + X_C)^2}}{Met $Z_{totaal}$ de totale impedantie in Ohm, R de weerstand in Ohm, $X_L$ de inductieve reactantie in Ohm en $X_C$ de capacatieve reactantie in Ohm.}{10}
\newlabel{frm:11}{{3}{7}{Hoofdstuk 2: Wisselstroom ketens}{section.3}{}}
\addformulariumentry{0}{Hoek van de impedantie}{\tan \phi = \frac  {X_L + X_C}{R}}{Met $\phi $ de fasehoek van de impedantie in radialen, R de weerstand in Ohm, $X_L$ de inductieve reactantie in Ohm en $X_C$ de capacatieve reactantie in Ohm.}{11}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Vermogen in wisselstroomkringen}{8}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Vermogen in functie van tijd.}}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:vermogen.png}{{2}{8}{Vermogen in functie van tijd}{figure.caption.2}{}}
\newlabel{frm:12}{{3.1}{8}{Vermogen in wisselstroomkringen}{figure.caption.3}{}}
\addformulariumentry{0}{Actief vermogen}{P = V_{rms} I_{rms} \cos \phi }{Met P het actieve vermogen in Watt, $V_{rms}$ de effectieve spanning in Volt, $I_{rms}$ de effectieve stroom in Ampère en $\phi $ de fasehoek tussen spanning en stroom in radialen.}{12}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stroom die achterloopt op de spanning.}}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:stroomachtervoltage.png}{{3}{9}{Stroom die achterloopt op de spanning}{figure.caption.3}{}}
\newlabel{frm:13}{{3.1}{9}{Vermogen in wisselstroomkringen}{figure.caption.3}{}}
\addformulariumentry{0}{Schijnbaar vermogen}{S = V_{rms} I_{rms}}{Met S het schijnbaar vermogen in Volt-Ampère (VA), $V_{rms}$ de effectieve spanning in Volt en $I_{rms}$ de effectieve stroom in Ampère.}{13}
\newlabel{frm:14}{{3.1}{9}{Vermogen in wisselstroomkringen}{figure.caption.3}{}}
\addformulariumentry{0}{reactief vermogen}{Q = V_{rms} I_{rms} \sin \phi }{Met Q het reactief vermogen in Volt-Ampère reactief (VAR), $V_{rms}$ de effectieve spanning in Volt, $I_{rms}$ de effectieve stroom in Ampère en $\phi $ de fasehoek tussen spanning en stroom in radialen.}{14}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Vermogendriehoek die de relatie toont tussen actief vermogen P, reactief vermogen Q en schijnbaar vermogen S.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:Vermogendriehoek.png}{{4}{9}{Vermogendriehoek die de relatie toont tussen actief vermogen P, reactief vermogen Q en schijnbaar vermogen S}{figure.caption.4}{}}
\newlabel{frm:15}{{3.1}{9}{Vermogen in wisselstroomkringen}{figure.caption.4}{}}
\addformulariumentry{0}{Vermogendriehoek}{S = P + iQ}{Met S het schijnbaar vermogen in Volt-Ampère (VA), P het actieve vermogen in Watt en Q het reactief vermogen in Volt-Ampère reactief (VAR).}{15}
\newlabel{frm:16}{{3.1}{9}{Vermogen in wisselstroomkringen}{figure.caption.4}{}}
\addformulariumentry{0}{Arbeidsfactor}{\text  {arbeidsfactor} = \cos \phi = \frac  {P}{S}}{Met de arbeidsfactor de verhouding is tussen het actieve vermogen P en het schijnbaar vermogen S. Het geeft aan welk deel van het schijnbaar vermogen daadwerkelijk wordt omgezet in nuttig werk.}{16}
\newlabel{frm:17}{{3.1}{10}{Vermogen in wisselstroomkringen}{figure.caption.4}{}}
\addformulariumentry{0}{cosine regel}{c^2 = a^2 + b^2 - 2ab \cos \theta }{Met a, b en c de lengtes van de zijden van een driehoek en $\theta $ de hoek tegenover zijde c.}{17}
\newlabel{frm:18}{{3.1}{10}{Vermogen in wisselstroomkringen}{figure.caption.4}{}}
\addformulariumentry{0}{sine regel}{\frac  {a}{\sin A} = \frac  {b}{\sin B} = \frac  {c}{\sin C}}{Met a, b en c de lengtes van de zijden van een driehoek en A, B en C de hoeken tegenover zijden a, b en c respectievelijk.}{18}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Driehoek met zijden $a$, $b$, $c$ tegenover hoeken $A$, $B$, $C$. Voor de cosinusregel geldt (met $\theta = \angle C$): $c^2 = a^2 + b^2 - 2ab\cos \theta $. De sinusregel: $\frac  {a}{\sin A} = \frac  {b}{\sin B} = \frac  {c}{\sin C}$.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:triangle-rules}{{5}{10}{Driehoek met zijden $a$, $b$, $c$ tegenover hoeken $A$, $B$, $C$. Voor de cosinusregel geldt (met $\theta = \angle C$): $c^2 = a^2 + b^2 - 2ab\cos \theta $. De sinusregel: $\frac {a}{\sin A} = \frac {b}{\sin B} = \frac {c}{\sin C}$}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Resonantie}{11}{subsection.3.2}\protected@file@percent }
\newlabel{frm:19}{{3.2}{11}{Resonantie}{subsection.3.2}{}}
\addformulariumentry{0}{Resonatie frequentie}{f_0 = \frac  {1}{2\pi \sqrt  {LC}}}{Met $f_0$ de resonantiefrequentie in Hertz, L de inductantie in Henry en C de capaciteit in Farad.}{19}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Resonantie in een RLC-seriekring. Bij de resonantiefrequentie $f_0$ zijn de inductieve en capacatieve reactanties gelijk, waardoor de totale impedantie minimaal is en de stroom maximaal.}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{fig:resonatie.png}{{6}{11}{Resonantie in een RLC-seriekring. Bij de resonantiefrequentie $f_0$ zijn de inductieve en capacatieve reactanties gelijk, waardoor de totale impedantie minimaal is en de stroom maximaal}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Hoofdstuk 3: Elektrische netwerken}{11}{section.4}\protected@file@percent }
\newlabel{frm:20}{{4}{11}{Hoofdstuk 3: Elektrische netwerken}{section.4}{}}
\addformulariumentry{0}{Belastingen in serie}{Z_{totaal} = Z_1 + Z_2 + ... + Z_n}{Met $Z_{totaal}$ de totale impedantie in Ohm en $Z_1, Z_2, ..., Z_n$ de individuele impedanties in Ohm.}{20}
\newlabel{frm:21}{{4}{12}{Hoofdstuk 3: Elektrische netwerken}{section.4}{}}
\addformulariumentry{0}{Belastingen in parallel}{\frac  {1}{Z_{totaal}} = \frac  {1}{Z_1} + \frac  {1}{Z_2} + ... + \frac  {1}{Z_n}}{Met $Z_{totaal}$ de totale impedantie in Ohm en $Z_1, Z_2, ..., Z_n$ de individuele impedanties in Ohm.}{21}
