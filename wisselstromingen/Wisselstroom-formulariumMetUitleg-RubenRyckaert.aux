\newlabel{fig:fasorsindriehoek.png}{{11}{16}{Driehoekconfiguratie fasordiagram van de lijn en fasespanningen en de}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}omzetting ster- naar driehoekconfiguratie}{16}{subsection.5.3}\protected@file@percent }
\newlabel{frm:24}{{5.3}{16}{omzetting ster- naar driehoekconfiguratie}{subsection.5.3}{}}
\addformulariumentry{0}{Delta naar Ster en omgekeerd}{Z_Y = \frac  {Z_\Delta }{3} \hskip 1em\relax , \hskip 1em\relax Z_\Delta = 3 Z_Y}{Met $\mathbf  {Z}_Y$ de impedantie van de equivalente Y-verbonden belasting in Ohm en $\mathbf  {Z}_\Delta $ de impedantie van de $\Delta $-verbonden belasting in Ohm.}{24}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Omzetting ster- naar driehoekconfiguratie en omgekeerd.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:omzettingster en driehoek.png}{{12}{17}{Omzetting ster- naar driehoekconfiguratie en omgekeerd}{figure.caption.12}{}}
\newlabel{frm:25}{{5.3}{17}{omzetting ster- naar driehoekconfiguratie}{figure.caption.12}{}}
\addformulariumentry{0}{Omzetting ster- naar driehoekconfiguratie}{Z_a = \frac  {Z_{1} Z_{2}}{Z_{1} + Z_{2} + Z_{3}} \hskip 1em\relax , \hskip 1em\relax Z_b = \frac  {Z_{1} Z_{2}}{Z_{1} + Z_{2} + Z_{3}} \hskip 1em\relax , \hskip 1em\relax Z_c = \frac  {Z_{2} Z_{3}}{Z_{1} + Z_{2} + Z_{3}}}{\par }{25}
\newlabel{frm:26}{{5.3}{17}{omzetting ster- naar driehoekconfiguratie}{figure.caption.12}{}}
\addformulariumentry{0}{Omzetting driehoek- naar sterconfiguratie}{Z_{1} = \frac  {Z_{a} Z_{b} + Z_{b} Z_{c} + Z_{c} Z_{a}}{Z_{c}} \hskip 1em\relax , \hskip 1em\relax Z_{2} = \frac  {Z_{a} Z_{b} + Z_{b} Z_{c} + Z_{c} Z_{a}}{Z_{a}} \hskip 1em\relax , \hskip 1em\relax Z_{3} = \frac  {Z_{a} Z_{b} + Z_{b} Z_{c} + Z_{c} Z_{a}}{Z_{b}}}{\par }{26}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \relax }}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:vboefening.png}{{13}{17}{\relax }{figure.caption.13}{}}
