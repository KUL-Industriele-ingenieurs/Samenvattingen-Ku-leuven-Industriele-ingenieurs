% school-macros.sty
% Unified macros for KU Leuven engineering course documents
% Version 2.1 - Optimized following LaTeX best practices
%
% Features: Formula collection (\frm), Symbol registration (\sym), 
%           Themed boxes, siunitx integration, Dutch localization
%
% Usage: \usepackage{school-macros}
% Note: Compile twice for formularium and symbol list

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{school-macros}[2026/01/09 v2.1 KU Leuven School Macros]

% ============================================================================
%                              PACKAGE LOADING
% ============================================================================
% Packages are grouped by function and loaded in optimal order.
% hyperref and cleveref are loaded last as required.

% --- Encoding & Language ---
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[dutch]{babel}

% --- Fonts & Typography ---
\RequirePackage{lmodern}
\RequirePackage{microtype}  % Improved text appearance
\RequirePackage{parskip}    % Paragraph spacing instead of indent
\RequirePackage{setspace}   % For line spacing
\setstretch{1.15}           % Slightly larger for better readability

% --- Math (mathtools extends amsmath) ---
\RequirePackage{mathtools}
\RequirePackage{amssymb}
\RequirePackage{amsthm}

% --- Units & Numbers (siunitx for consistent formatting) ---
\RequirePackage{siunitx}
\sisetup{
    locale = DE,                    % European number format (comma decimal)
    per-mode = symbol,              % Use / for per
    separate-uncertainty = true,    % Show uncertainty separately
    output-decimal-marker = {,},    % Dutch decimal comma
    group-separator = {\,},         % Thin space for thousands
    detect-all=true,                % Adapt to surrounding font
}

% --- Tables ---
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}

% --- Graphics & Floats ---
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{placeins}
\RequirePackage{flafter}    % Ensure floats don't appear before definition

% --- Colors ---
\RequirePackage{xcolor}

% --- Boxes (tcolorbox with libraries) ---
\RequirePackage[breakable, skins]{tcolorbox}

% --- Lists ---
\RequirePackage{enumitem}

% --- Code Listings ---
\RequirePackage{listings}

% --- Layout ---
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{multicol}

% --- Utilities ---
\RequirePackage{etoolbox}
\RequirePackage{xstring}
\RequirePackage{ifthen}

% --- Chemistry ---
\RequirePackage[version=4]{mhchem}
\RequirePackage{chemfig}

% --- Circuits ---
\RequirePackage[european]{circuitikz}

% --- Euro Symbol Support ---
\RequirePackage{textcomp}
\RequirePackage{newunicodechar}

% --- Graphics & Plots ---
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
\usetikzlibrary{
    arrows.meta, positioning, calc, patterns, shapes.geometric,
    angles, quotes, babel, decorations.pathmorphing, shapes.misc, fit
}

% --- Bibliography (BibLaTeX for Zotero integration) ---
% NOTE: Users should add \addbibresource{references.bib} in their document preamble
% and \printbibliography at the end. Export from Zotero as BibLaTeX.
\RequirePackage[
    backend=biber,
    style=numeric,
    sorting=none,
    maxbibnames=3,
    minbibnames=1,
    maxcitenames=2,
    mincitenames=1,
    doi=false,
    isbn=false,
    url=true,
    eprint=false,
]{biblatex}

% --- Hyperlinks (load near last, after biblatex) ---
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,        % TOC and internal links in black
    urlcolor=schoolBlue,
    citecolor=schoolBlue,
    hidelinks,              % Clean look
    hypertexnames=false,    % Avoid duplicate destination names
}
\RequirePackage{bookmark}   % Improved bookmarks management

% --- Smart References (load after hyperref) ---
\RequirePackage[dutch, nameinlink, capitalise]{cleveref}
% Dutch cleveref names
\crefname{equation}{vergelijking}{vergelijkingen}
\Crefname{equation}{Vergelijking}{Vergelijkingen}
\crefname{figure}{figuur}{figuren}
\Crefname{figure}{Figuur}{Figuur}
\crefname{table}{tabel}{tabellen}
\Crefname{table}{Tabel}{Tabel}
\crefname{section}{sectie}{secties}
\Crefname{section}{Sectie}{Secties}
\crefname{chapter}{hoofdstuk}{hoofdstukken}
\Crefname{chapter}{Hoofdstuk}{Hoofdstukken}

