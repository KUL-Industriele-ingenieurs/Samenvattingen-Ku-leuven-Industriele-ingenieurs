% ============================================================================
%                          PLOTTING HELPERS
% ============================================================================

% 3D Surface Plot
% Usage: \plotthreeD[axis options]{plot options}{function}
% Example: \plotthreeD[xlabel=x, ylabel=y]{domain=-2:2}{x^2 - y^2}
\newcommand{\plotthreeD}[3][]{%
    \begin{center}
    \begin{tikzpicture}
    \begin{axis}[
        width=0.8\linewidth,
        grid=major,
        view={60}{30},
        colormap/viridis,
        #1
    ]
    \addplot3[surf, shader=faceted, samples=25, #2] {#3};
    \end{axis}
    \end{tikzpicture}
    \end{center}
}

% Data Plot from CSV
% Usage: \plotdata[axis options]{plot options}{filename.csv}
% Example: \plotdata[xlabel=Time, ylabel=Volt]{x=time, y=voltage}{data.csv}
\newcommand{\plotdata}[3][]{%
    \begin{center}
    \begin{tikzpicture}
    \begin{axis}[
        width=0.8\linewidth,
        grid=major,
        #1
    ]
    \addplot table[col sep=comma, #2] {#3};
    \end{axis}
    \end{tikzpicture}
    \end{center}
}

