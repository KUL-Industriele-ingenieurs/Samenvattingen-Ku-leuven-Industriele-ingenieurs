%                           TCOLORBOX ARCHITECTURE (v3.0)
% ============================================================================ 

% Base style for "Attached Title" boxes
\tcbset{
    schoolbox/.style={ 
        enhanced, breakable,
        arc=3pt, boxrule=0.5pt,
        attach boxed title to top left={xshift=5mm, yshift*=-\tcboxedtitleheight/2},
        boxed title style={sharp corners, rounded corners=northeast, drop fuzzy shadow, colback=#1},
        colframe=#1, colback=white,
        drop fuzzy shadow,
        fonttitle=\bfseries\sffamily,
        before skip=12pt,
        after skip=12pt
    },
    % Backwards compatible alias: older docs used `schoolstyle`
    % Map `schoolstyle` to `schoolbox` with default color `schoolBlue`.
    schoolstyle/.style={schoolbox=schoolBlue},
    % Legacy style alias (to prevent breakages if used directly)
    schoolbase/.style={
        blanker, breakable, left=12pt, borderline west={3pt}{0pt}{schoolBlue}
    }
}

% --- Semantic Environments ---

% Theorie (Blue, Book Icon)
\newtcolorbox[auto counter, number within=section]{theorie}[2][]{
    schoolbox=schoolBlue,
    title={\faBook\ \textbf{Stelling~\thetcbcounter:} #2},
