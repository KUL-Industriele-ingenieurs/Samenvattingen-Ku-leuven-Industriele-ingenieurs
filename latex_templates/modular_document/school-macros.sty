% ============================================================================ 
%                           FORMULA SYSTEM (\frm)
% ============================================================================ 
% Updated to use 'schoolbox' style for consistency

\newcommand*{\FormulariumSections}{}
\newcounter{FormulariumEntryCounter}
\newcounter{FormulariumSectionCounter}

\makeatletter
% Track current section number and title for formula grouping
\newcommand*{\@currentFormulariumSection}{0}
\newcommand*{\@currentSectionTitle}{}

\newcommand{\addformulariumentry}[6]{% 
    % #1=section, #2=section title, #3=label, #4=math, #5=description, #6=counter
    \ifinlist{#1}{\FormulariumSections}{}{% 
        \listgadd{\FormulariumSections}{#1}%
        \global\csdef{SectionFormulas@#1}{}% 
        \global\csdef{SectionTitle@#1}{#2}%
    }%
    \csxappto{SectionFormulas@#1}{% 
        \noexpand\formulariumcard{#3}{\unexpanded{#4}}{\unexpanded{#5}}{#6}%
    }%
}

% Card in Appendix
\newcommand{\formulariumcard}[4]{% 
    \par\vspace{6pt}%
    \noindent\textbf{#1} \hfill {\scriptsize\textcolor{schoolGray}{\hyperref[frm:#4]{p.~\pageref{frm:#4}}}}\\[4pt]%
    {\centering\large $\displaystyle #2$\par}%
    \vspace{2pt}%
    {\noindent\footnotesize\itshape #3}%
    \par\vspace{6pt}%
}

% Main \frm macro using new tcolorbox style
\newcommand{\frm}[3]{% 
    \stepcounter{FormulariumEntryCounter}%
    % We use a specific style for formulas inline
    \begin{tcolorbox}[
        schoolbox=schoolOrange,
        title={\faCalculator\ \textbf{#1}},
        fonttitle=\bfseries\sffamily,
    ]
        {\centering\large $\displaystyle #2$\par}%
        \vspace{4pt}%
        {\small #3}\label{frm:\theFormulariumEntryCounter}%
    \end{tcolorbox}%
    \protected@write\@auxout{}{\string\addformulariumentry{\thesection}{\@currentlabelname}{\unexpanded{#1}}{\unexpanded{#2}}{\unexpanded{#3}}{\theFormulariumEntryCounter}}%
    \par\vspace{4pt}%
}

\newcommand*{\printSectionFormulas}[1]{% 
    \ifthenelse{\equal{#1}{0}}{}{% 
        \par\vspace{10pt}
        \noindent\makebox[\linewidth]{% 
            \textcolor{schoolBlue}{\leaders\hrule height 1pt\hfill}\hspace{1em}%
            {\small\bfseries\sffamily\textcolor{schoolBlue}{\csuse{SectionTitle@#1}}}\hspace{1em}%
            \textcolor{schoolBlue}{\leaders\hrule height 1pt\hfill}%
        }%
        \par\vspace{6pt}%
    }%
    \csuse{SectionFormulas@#1}%
}

\newcommand{\school@sectionstar}[1]{% 
    \ifdefined\FloatBarrier\FloatBarrier\fi
    \@ifundefined{chapter}{% 
        \subsection*{#1}%
        \addcontentsline{toc}{subsection}{\protect\numberline{}#1}%
    }{% 
        \section*{#1}%
        \addcontentsline{toc}{section}{\protect\numberline{}#1}%
    }% 
}
\newcommand*{\printformularium}{% 
    \par
    \school@sectionstar{Formularium}%
    \ifdefempty{\FormulariumSections}{% 
        \noindent\textit{Nog geen formules geregistreerd. Compileer tweemaal.}%
    }{% 
        \forlistloop{\printSectionFormulas}{\FormulariumSections}%
    }%
    \par
}

\newcommand*{\printformulariumtwocol}{% 
    \par
    \school@sectionstar{Formularium}%
    \ifdefempty{\FormulariumSections}{% 
        \noindent\textit{Nog geen formules geregistreerd. Compileer tweemaal.}%
    }{% 
        \begin{multicols}{2}
        \forlistloop{\printSectionFormulas}{\FormulariumSections}%
        \end{multicols}%
    }%
    \par
}
\makeatother

% ============================================================================ 
%                           SYMBOL SYSTEM (\sym)
% ============================================================================ 

\newcommand*{\SymbolList}{}

\makeatletter
\newcommand{\symentry}[4]{\g@addto@macro\SymbolList{$#1$ & #2 & \si{#3} & \hyperlink{sym:#1}{#4}\\}}
\newcommand{\symwrite}[4]{\protected@write\@auxout{}{\string\symentry{#1}{#2}{#3}{#4}}}

\newcommand{\sym}[3]{% 
    \expandafter\ifx\csname sym@\string#1\endcsname\relax
        \expandafter\gdef\csname sym@\string#1\endcsname{1}%
        \hypertarget{sym:#1}{}% 
        % Inline definition box
        \begin{tcolorbox}[
            enhanced, breakable,
            colback=white, colframe=schoolGray,
            left=6pt, right=6pt, top=4pt, bottom=4pt,
            borderline west={3pt}{0pt}{schoolGray},
            frame hidden,
            before skip=4pt, after skip=4pt
        ]
            \textbf{\ensuremath{#1}} --- #2 \hfill {\footnotesize\textcolor{schoolGray}{\si{#3}}}
        \end{tcolorbox}%
        \symwrite{#1}{#2}{#3}{\thepage}%
    \else
        {\small\textbf{\ensuremath{#1}} --- #2 [\si{#3}]}% 
    \fi
}

\newcommand*{\printsymbols}{% 
    \par
    \school@sectionstar{Symbolenlijst}%
    \begin{tabularx}{\textwidth}{l X l r}
        \toprule
        \textbf{Symbool} & \textbf{Beschrijving} & \textbf{Eenheid} & \textbf{Pagina} \\
        \midrule
        \SymbolList
        \bottomrule
    \end{tabularx}\par
}
\makeatother

