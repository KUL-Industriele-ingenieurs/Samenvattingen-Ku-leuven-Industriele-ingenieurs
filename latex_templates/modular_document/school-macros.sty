% school-macros.sty
% Unified macros for KU Leuven engineering course documents
% Version 3.0 - "School Macros v3.0" - Cognitive Ergonomie & Engineering Focus
% 
% Features: 
% - Typography: Bitstream Charter (Serif) + Fira Sans (Header) + Fira Mono (Code)
% - Visuals: "Attached Title" boxes with icons and shadow
% - Data: tabularray + siunitx integration, Engineering Plots
% - Workflow: Speed macros (\mat), IDE-like code blocks
% 
% Usage: \usepackage{school-macros}
% Note: Compile twice for formularium and symbol list

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{school-macros}[2026/01/12 v3.0 KU Leuven School Macros - Engineering Edition]

