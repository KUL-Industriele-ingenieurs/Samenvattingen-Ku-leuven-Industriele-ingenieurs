% 3D Surface Plot
\newcommand{\plotthreeD}[3][]{% 
    \begin{center}
    \begin{tikzpicture}
    \begin{axis}[
        width=0.8\linewidth,
        grid=major,
        view={60}{30},
        colormap/viridis,
        schoolEngineeringPlot, % Apply new style
        #1
    ]
    \addplot3[surf, shader=faceted, samples=25, #2] {#3};
    \end{axis}
    \end{tikzpicture}
