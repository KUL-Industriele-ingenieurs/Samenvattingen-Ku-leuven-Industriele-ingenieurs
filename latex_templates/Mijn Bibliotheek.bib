@thesis{claesenLCCVanBiocomposiet2023,
  title = {LCC van biocomposiet bruggen - Invloed van materiaalkeuze voor de draagstructuur op de onderhoudskost bij fietsbruggen},
  author = {Claesen, Ruben},
  namea = {Thooft, Koenraad and Jansen, Dennie and {KU Leuven Faculteit Industriële Ingenieurswetenschappen Opleiding Master in de industriële wetenschappen Bouwkunde}},
  nameatype = {collaborator},
  date = {2023},
  institution = {KU Leuven. Faculteit Industriële Ingenieurswetenschappen},
  location = {Leuven},
  abstract = {In de huidige maatschappij wordt het klimaatprobleem alsmaar belangrijker. De bouwsector heeft een grote invloed op de klimaatcrisis. Bijgevolg is het opportuun om naar oplossingen te zoeken die de impact van de bouwsector op de klimaatcrisis kunnen verkleinen. In de bruggenbouw is deze beweging te zien door projecten zoals het Smart Circular Bridge project en het BIOCAS-project. Deze projecten draaien rond het onderzoeken en ontwikkelen van biocomposietbruggen. Biocomposietbruggen bestaan geheel of gedeeltelijk uit natuurlijke vezels (bijvoorbeeld vlasvezels) met een matrix van biobased hars rond. De biocomposieten zijn een variant op de glasvezelcomposietbruggen die ondertussen steeds vaker worden toegepast in de bruggenbouw. Deze masterproef bespreekt de financiële haalbaarheid van biocomposietbruggen ten opzichte van andere brugmaterialen zoals staal, beton en glasvezelcomposiet. Door middel van een Life Cycle Costing (LCC) kan worden ingeschat wat de verschillen in kosten zijn voor de verschillende brugmaterialen over de levensduur van een brug. Deze masterproef gebruikt als case study het BIOCAS-project in Ritsumasyl. Hier is een biocomposietbrug geplaatst die met behulp van sensors constant wordt gemonitord en waarvoor een ontwerp en berekeningen zijn gemaakt voor meerdere verschillende materialen. Zo wordt een LCC gemaakt voor een staal, beton, composiet en biocomposietbrug. Een LCC bestaat uit een investeringskost, een onderhoudskost en een end-of-life kost. De focus ligt in de LCC op de onderhoudskost waarbij dieper wordt ingegaan op de coatings, de vorm, het transport en plaatsing, de verkeersopstoppingskost en de locatie van de brug. Door op die aspecten te focussen worden sterke, zwakke of punten zonder impact onderlijnd. Het onderzoeken van de onderhoudskosten geeft weer welke kosten boven op de investeringskosten komen om zo een goed beeld te vormen gedurende de levensduur en teruggerekend ook wat de eventuele meerkost kan zijn bij investering. De resultaten tonen aan dat de onderhoudskosten van een biocomposietbrug vergelijkbaar of minder goed zijn dan bij staal- en betonbruggen. De belangrijkste factor bij het drukken van de onderhoudskosten is de vorm en opbouw van de brug. Hoe kleiner de te coaten oppervlakte, hoe groter de besparing op het plaatsen van de coating. De coating van een biocomposietbrug is ten opzichte van de andere materialen duur en onderhoudsintensief. Een verbetering van de levensduur en kostprijs van het coatingpakket heeft daardoor een grote positieve invloed op de onderhoudskost van de brug. De verkeersopstoppingskost en de locatie geeft weinig verschil tussen de brugmaterialen. Hoewel de kostprijs bij het transport en de plaatsing de betonnen brug hoger ligt, blijft de kost voor de andere bruggen ongeveer gelijk. Verder is de kostprijs voor transport en plaatsing zo beperkt dat dit weinig invloed heeft op het totaalbedrag van de LCC. De eindconclusie van deze masterproef stelt dat biocomposieten mee kunnen concurreren met de andere brugmaterialen op vlak van onderhoudskosten. Echter om biocomposietbruggen over de volledige LCC mee te laten concurreren moet vooral de investeringskost zo dicht mogelijk of lager bij de investeringskost van de andere brugmaterialen worden gebracht.},
  langid = {dutch}
}

