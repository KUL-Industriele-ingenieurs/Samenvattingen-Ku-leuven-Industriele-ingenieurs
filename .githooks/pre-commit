#!/bin/sh
# Pre-commit hook to automatically manage PDFs and enforce branch rules
# Cross-platform (Windows Git Bash, Linux, macOS)

# --- 1. Enforce Branch Rules ---
current_branch=$(git rev-parse --abbrev-ref HEAD)
protected_branches="main master alpha"

for branch in $protected_branches; do
    if [ "$current_branch" = "$branch" ]; then
        echo "🛑 ERROR: Direct commits to '$current_branch' are not allowed!"
        echo "--------------------------------------------------------"
        echo "Please create your own branch to make changes:"
        echo "  git checkout -b my-feature-branch"
        echo "--------------------------------------------------------"
        exit 1
    fi
done

# --- 2. Manage PDFs ---
echo "Checking PDFs..."

# Stream NUL-separated names directly to preserve null bytes and read safely
unstaged_any=0

while IFS= read -r -d '' pdf_file; do
    # case-insensitive match for .pdf extension
    case "$pdf_file" in
        *.[Pp][Dd][Ff])
            tex_file="${pdf_file%.*}.tex"
            typ_file="${pdf_file%.*}.typ"
            if [ -f "$tex_file" ] || [ -f "$typ_file" ]; then
                matching_ext=".tex"
                [ -f "$typ_file" ] && matching_ext=".typ"
                echo "Unstaging generated PDF: $pdf_file (matches $matching_ext file)"
                git reset HEAD -- "$pdf_file"
                echo "🛑 ERROR: Generated PDF was staged and has been unstaged. Please review the unstaged PDF and commit again without it."
                exit 1
            else
                echo "Keeping reference PDF: $pdf_file"
            fi
            ;;
    esac
done < <(git diff --cached --name-only -z)

echo "PDF check complete."
exit 0