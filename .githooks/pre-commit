#!/bin/sh
# Pre-commit hook to automatically manage PDFs and enforce branch rules
# Cross-platform (Windows Git Bash, Linux, macOS)

# --- 1. Enforce Branch Rules ---
current_branch=$(git rev-parse --abbrev-ref HEAD)
protected_branches="main master alpha"

for branch in $protected_branches; do
    if [ "$current_branch" = "$branch" ]; then
        echo "🛑 ERROR: Direct commits to '$current_branch' are not allowed!"
        echo "--------------------------------------------------------"
        echo "Please create your own branch to make changes:"
        echo "  git checkout -b my-feature-branch"
        echo "--------------------------------------------------------"
        exit 1
    fi
done

# --- 2. Manage PDFs ---
echo "Checking PDFs..."

# Use a temporary file to store NUL-delimited names
# This avoids storing NUL bytes in bash variables and prevents git index locking
# issues that happen when piping git diff directly into a git reset.
# We use --diff-filter=d to ignore deleted files, allowing users to commit deletions of PDFs.
tmp_file=$(mktemp)
git diff --cached --name-only --diff-filter=d -z > "$tmp_file"

unstaged_any=0

while IFS= read -r -d '' pdf_file || [ -n "$pdf_file" ]; do
    if [ -z "$pdf_file" ]; then continue; fi
    # case-insensitive match for .pdf extension
    case "$pdf_file" in
        *.[Pp][Dd][Ff])
            tex_file="${pdf_file%.*}.tex"
            typ_file="${pdf_file%.*}.typ"
            if [ -f "$tex_file" ]; then
                echo "❌ BLOCKED: Unstaging generated PDF '$pdf_file'."
                echo "        Matches source file: '$tex_file'"
                echo "        Action: Automatically unstaging this file to protect the repository."
                git reset HEAD -q -- "$pdf_file"
                unstaged_any=1
            elif [ -f "$typ_file" ]; then
                echo "❌ BLOCKED: Unstaging generated PDF '$pdf_file'."
                echo "        Matches source file: '$typ_file'"
                echo "        Action: Automatically unstaging this file to protect the repository."
                git reset HEAD -q -- "$pdf_file"
                unstaged_any=1
            else
                echo "✅ ALLOWED: Keeping reference PDF '$pdf_file' (no matching .tex or .typ source file found)."
            fi
            ;;
    esac
done < "$tmp_file"

rm -f "$tmp_file"

if [ "$unstaged_any" -eq 1 ]; then
    echo ""
    echo "🛑 ERROR: One or more generated PDFs were staged for commit!"
    echo "        These files have been automatically UNSTAGED to protect the repository."
    echo "        Please review your staged changes and run 'git commit' again."
    exit 1
fi

echo "PDF check complete."
exit 0