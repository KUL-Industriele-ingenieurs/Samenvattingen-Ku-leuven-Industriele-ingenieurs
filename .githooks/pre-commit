#!/bin/sh
# Pre-commit hook to automatically manage PDFs and enforce branch rules
# Cross-platform (Windows Git Bash, Linux, macOS)

# --- 1. Enforce Branch Rules ---
current_branch=$(git rev-parse --abbrev-ref HEAD)
protected_branches="main master alpha"

for branch in $protected_branches; do
    if [ "$current_branch" = "$branch" ]; then
        echo "🛑 ERROR: Direct commits to '$current_branch' are not allowed!"
        echo "--------------------------------------------------------"
        echo "Please create your own branch to make changes:"
        echo "  git checkout -b my-feature-branch"
        echo "--------------------------------------------------------"
        exit 1
    fi
done

# --- 2. Manage PDFs ---
echo "Checking PDFs..."

# Get all staged PDFs (case-insensitive extension)
# git diff --cached --name-only returns file paths relative to root
staged_pdfs=$(git diff --cached --name-only | grep -i '\.pdf$' || true)

if [ -n "$staged_pdfs" ]; then
    # Set Internal Field Separator to newline to handle files one by one
    IFS='\n'
    blocked_pdfs=""

    for pdf_file in $staged_pdfs; do
        # Normalize .pdf/.PDF to .tex
        tex_file=$(echo "$pdf_file" | sed -E 's/\.[Pp][Dd][Ff]$/.tex/')

        # 1) If the corresponding .tex exists in the work tree OR is tracked, automatically unstage the PDF
        if [ -f "$tex_file" ] || git ls-files --error-unmatch "$tex_file" >/dev/null 2>&1; then
            echo "Unstaging generated PDF: $pdf_file (matches $tex_file)"
            git reset HEAD -- "$pdf_file"
            continue
        fi

        # 2) If a whitelist file exists and the PDF is listed there, allow it
        if [ -f ".pdf-whitelist" ]; then
            if grep -Fxq "$pdf_file" .pdf-whitelist; then
                echo "Whitelisted PDF allowed: $pdf_file"
                continue
            fi
        fi

        # Otherwise, block the PDF
        blocked_pdfs="$blocked_pdfs\n$pdf_file"
    done
    unset IFS

    if [ -n "$blocked_pdfs" ]; then
        echo "\n🛑 ERROR: Committing PDF files is blocked by policy. The following PDFs are staged:" >&2
        echo "$blocked_pdfs" >&2
        echo "\nIf these are generated files, remove them from the index with:" >&2
        echo "  git reset HEAD <path/to.pdf>" >&2
        echo "\nIf you intentionally want to commit a reference PDF, add its path to '.pdf-whitelist' (one path per line), then stage and commit that change first. Example:" >&2
        echo "  echo \"<path/to.pdf>\" >> .pdf-whitelist" >&2
        echo "  git add .pdf-whitelist && git commit -m \"chore: whitelist reference PDF: <path/to.pdf>\"" >&2
        echo "\nYou can bypass this hook with '--no-verify' if absolutely necessary, but prefer whitelisting so the repo policy is explicit." >&2
        exit 1
    fi
fi

echo "PDF check complete."
exit 0