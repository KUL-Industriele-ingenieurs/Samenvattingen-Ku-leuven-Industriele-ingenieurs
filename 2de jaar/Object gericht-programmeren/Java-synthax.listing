\section{Scanner}

De code om van de Scanner krijg je op het examen maar niet hoe je die gebruikt.
\begin{codeblock}[scanner]{java}
    import java.util.Scanner; //importeer de Scanner klasse

    public class MijnKlasse {

    public MijnKlasse() {
    }

    public int sumOfTwoNumbers(int a, int b) {
        return a + b;
    }

    public scanfile(filename) {
        Scanner sc = new Scanner(new File(filename)); // maak een Scanner object om van een bestand te lezen

        while (sc.hasNextLine()) { // zolang er nog een volgende lijn is
            String lijn = sc.nextLine(); // lees de volgende lijn
            System.out.println(lijn); // print de lijn naar de console
        }

        niet elke lijn zal een string zijn, soms moet je een int of float lezen
        int nummer = sc.nextInt(); // lees een geheel getal
        float decimaal = sc.nextFloat(); // lees een decimaal getal

        //methodes kan je dan met deze waarden aanroepen
        while (sc.hasNextInt()) {
        int a = sc.nextInt(); // lees het volgende gehele getal
        int b = sc.nextInt(); // lees het volgende gehele getal
        int resultaat = sumOfTwoNumbers(a, b); // roep de methode aan met het gelezen nummer
        System.out.println("Resultaat: " + resultaat);
    }

        sc.close(); // sluit de scanner
    }
